# Copy this file to .env, then replace every change-me value before starting.

# --- Postgres ---
POSTGRES_USER=it_jobs_admin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost      
POSTGRES_PORT=5433
POSTGRES_DB=it_jobs_dw

# --- MinIO ---
MINIO_ROOT_USER=change_me_access_key            # At least 3 characters.
MINIO_ROOT_PASSWORD=change_me_min_8_chars       # At least 8 characters.
AWS_ENDPOINT_URL=http://localhost:9100   
AWS_ACCESS_KEY_ID=change_me_access_key          # Same as MINIO_ROOT_USER.
AWS_SECRET_ACCESS_KEY=change_me_min_8_chars     # Same as MINIO_ROOT_PASSWORD.
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
MINIO_BUCKET=it-jobs-lakehouse

# --- Airflow ---
# Paste a key made by the command below (44 characters); do not type your own.
# generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" and then replace the value below.
AIRFLOW_FERNET_KEY=                     
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- Optional Kaggle CSV path ---
# download here: https://www.kaggle.com/datasets/bismasajjad/global-ai-job-market-and-salary-trends-2025
KAGGLE_CSV_PATH=data/raw/kaggle/ai_job_dataset.csv

# --- Pipeline data-quality guards ---
DQ_ITVIEC_FRESHNESS_HOURS=72
DQ_RECENT_WINDOW_HOURS=36
DQ_BASELINE_WINDOW_DAYS=14
DQ_VOLUME_RECENT_DAYS=7
DQ_VOLUME_BASELINE_DAYS=28
DQ_VOLUME_MIN_ACTIVE_DAYS=14
DQ_VOLUME_MIN_RATIO=0.20
DQ_COVERAGE_MIN_RECENT_JOBS=5
DQ_COVERAGE_MIN_BASELINE_JOBS=20
DQ_COVERAGE_MAX_DROP=0.20

PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# --- Optional Telegram failure alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional GCP ---
GCS_BUCKET=

# --- Optional hosted-dashboard serving database ---
SUPABASE_DB_URL=
